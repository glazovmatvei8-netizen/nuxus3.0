
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information within the NuxusChat application, enabling personalized interactions and identification.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "name": {
          "type": "string",
          "description": "The full display name of the user."
        },
        "username": {
          "type": "string",
          "description": "A unique public identifier for the user, typically starting with '@'. Used for search and direct mentions."
        },
        "phone": {
          "type": "string",
          "description": "The user's phone number, used as a unique contact identifier for registration and login."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user's profile picture.",
          "format": "uri"
        },
        "lastSeen": {
          "type": "string",
          "description": "ISO timestamp of the last time the user was active.",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user profile was created.",
          "format": "date-time"
        },
        "blockedUserIds": {
          "type": "array",
          "description": "List of user IDs that this user has blocked.",
          "items": {
            "type": "string"
          }
        },
        "isBanned": {
          "type": "boolean",
          "description": "Indicates if the user is globally banned from the application."
        }
      },
      "required": [
        "id",
        "name",
        "username",
        "phone",
        "createdAt"
      ]
    },
    "Chat": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chat",
      "type": "object",
      "description": "Represents a conversation, which can be a private direct message, a multi-user group, or a broadcast channel.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Chat entity."
        },
        "type": {
          "type": "string",
          "description": "The classification of the chat, either 'private', 'group', or 'channel'."
        },
        "name": {
          "type": "string",
          "description": "The display name of the chat."
        },
        "username": {
          "type": "string",
          "description": "A unique public identifier for group or channel chats."
        },
        "description": {
          "type": "string",
          "description": "A descriptive text providing information about the channel or group."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the chat's avatar image.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the chat was created.",
          "format": "date-time"
        },
        "ownerId": {
          "type": "string",
          "description": "UserProfile ID who owns this chat."
        },
        "participantIds": {
          "type": "array",
          "description": "References to UserProfile IDs who are participants.",
          "items": {
            "type": "string"
          }
        },
        "adminIds": {
          "type": "array",
          "description": "References to UserProfile IDs who are admins.",
          "items": {
            "type": "string"
          }
        },
        "typing": {
          "type": "object",
          "description": "Map of user IDs to typing status."
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "createdAt",
        "participantIds"
      ]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a single message.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier."
        },
        "chatId": {
          "type": "string",
          "description": "Chat reference."
        },
        "senderId": {
          "type": "string",
          "description": "Sender reference."
        },
        "senderName": {
          "type": "string",
          "description": "Cached sender name."
        },
        "content": {
          "type": "string",
          "description": "Textual content or media URL."
        },
        "contentType": {
          "type": "string",
          "description": "Content type: 'text', 'image', 'audio', 'video', 'service'."
        },
        "sentAt": {
          "type": "string",
          "description": "Sent timestamp.",
          "format": "date-time"
        },
        "replyToId": {
          "type": "string",
          "description": "Reference to another Message ID."
        },
        "replyToContent": {
          "type": "string",
          "description": "Snippet of replied message."
        },
        "editedAt": {
          "type": "string",
          "description": "Last edited timestamp.",
          "format": "date-time"
        },
        "isRead": {
          "type": "boolean",
          "description": "Read status."
        }
      },
      "required": [
        "id",
        "chatId",
        "senderId",
        "content",
        "contentType",
        "sentAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores individual user profile information."
        }
      },
      {
        "path": "/chats/{chatId}",
        "definition": {
          "entityName": "Chat",
          "schema": {
            "$ref": "#/backend/entities/Chat"
          },
          "description": "Stores metadata for all conversation types."
        }
      },
      {
        "path": "/chats/{chatId}/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": {
            "$ref": "#/backend/entities/Message"
          },
          "description": "Stores individual messages for a specific chat."
        }
      }
    ]
  }
}
