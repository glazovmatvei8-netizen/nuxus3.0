
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile information within the Nuxus application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPremium": { "type": "boolean" },
        "balance": { "type": "number", "default": 0 },
        "installedStickerPackIds": { "type": "array", "items": { "type": "string" } },
        "countryCode": { "type": "string", "description": "ISO 3166-1 alpha-2 country code." }
      },
      "required": ["id", "name", "username", "phone", "createdAt"]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Financial transaction record.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "transfer_in", "transfer_out"] },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "otherPartyId": { "type": "string" },
        "otherPartyName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "type", "status", "createdAt"]
    },
    "TopUpRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "TopUpRequest",
      "type": "object",
      "description": "A manual request to top up balance.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "status", "createdAt"]
    },
    "StickerPack": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StickerPack",
      "type": "object",
      "description": "A collection of stickers created by a user.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "iconUrl": { "type": "string" },
        "stickerUrls": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "stickerUrls", "createdAt"]
    },
    "Chat": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chat",
      "type": "object",
      "description": "Represents a conversation.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "name", "createdAt", "participantIds"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "description": "Represents a single message, including polls.",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "contentType": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "chatId", "senderId", "content", "contentType", "sentAt"]
    },
    "Story": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Story",
      "type": "object",
      "description": "Represents a short-lived user story.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "contentType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "viewers": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "userId", "content", "contentType", "createdAt", "expiresAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile", "schema": { "$ref": "#/backend/entities/UserProfile" }, "description": "Stores user profiles." }
      },
      {
        "path": "/users/{userId}/transactions/{transactionId}",
        "definition": { "entityName": "Transaction", "schema": { "$ref": "#/backend/entities/Transaction" }, "description": "Stores user transaction history." }
      },
      {
        "path": "/topUpRequests/{requestId}",
        "definition": { "entityName": "TopUpRequest", "schema": { "$ref": "#/backend/entities/TopUpRequest" }, "description": "Stores manual top-up requests." }
      },
      {
        "path": "/stickerPacks/{packId}",
        "definition": { "entityName": "StickerPack", "schema": { "$ref": "#/backend/entities/StickerPack" }, "description": "Stores sticker pack metadata." }
      },
      {
        "path": "/chats/{chatId}",
        "definition": { "entityName": "Chat", "schema": { "$ref": "#/backend/entities/Chat" }, "description": "Stores chat metadata." }
      },
      {
        "path": "/chats/{chatId}/messages/{messageId}",
        "definition": { "entityName": "Message", "schema": { "$ref": "#/backend/entities/Message" }, "description": "Stores chat messages." }
      },
      {
        "path": "/stories/{storyId}",
        "definition": { "entityName": "Story", "schema": { "$ref": "#/backend/entities/Story" }, "description": "Stores user stories." }
      }
    ]
  }
}
