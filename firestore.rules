
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ГЛАВНЫЙ КОРЕНЬ NUXUS PRIME (vnctow46)
    function isPrimeAdmin() {
      return isSignedIn() && request.auth.uid == 'vnctow46';
    }

    function isAdmin() {
      return isPrimeAdmin() || (isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '79513332147' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '79508784513'
        ))
      ));
    }

    // БЛОКИРОВКА ТВИНКОВ (oAMi... и другие пустые дубли)
    function isBannedTwin() {
      return request.auth.uid == 'oAMiCwJacaZPx5w3jaJtDoLPgZN2';
    }

    function isChatMember(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
      );
    }
    
    function isChatAdmin(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
         request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId ||
         isAdmin())
      );
    }

    match /users/{userId} {
      allow read, write: if !isBannedTwin() && (isPrimeAdmin() || isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow read: if !isBannedTwin();
      
      match /receivedGifts/{giftId} {
        allow read, list: if isSignedIn() && !isBannedTwin();
        allow write: if isAdmin();
      }
    }

    match /calls/{callId} {
      allow create, read, list, update, delete: if isSignedIn() && !isBannedTwin();
    }

    match /chats/{chatId} {
      allow read, list, create, update: if isSignedIn() && !isBannedTwin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, list, create: if (isChatMember(chatId) || isAdmin()) && !isBannedTwin();
        
        allow update: if !isBannedTwin() && isChatMember(chatId) && (
          request.auth.uid == resource.data.senderId || 
          isChatAdmin(chatId) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
        );
          
        allow delete: if isAdmin() || isChatAdmin(chatId) || (isSignedIn() && request.auth.uid == resource.data.senderId);
      }
    }

    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }
  }
}
