
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotBanned() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Если профиля еще нет, разрешаем доступ (он создастся при первом heartbeat)
      // Если профиль есть, проверяем флаг isBanned
      return !exists(userPath) || get(userPath).data.get('isBanned', false) == false;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Админ определяется по номеру телефона в его профиле
      return isSignedIn() && exists(userPath) && get(userPath).data.get('phone', '') == '+79513332147';
    }

    function isParticipant(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return isSignedIn() && exists(chatPath) && (request.auth.uid in get(chatPath).data.get('participantIds', []));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn() && isNotBanned();
      allow create: if isSignedIn() && isNotBanned();
      allow update: if isSignedIn() && isNotBanned(); 
      allow delete: if (isSignedIn() && exists(/databases/$(database)/documents/chats/$(chatId)) && get(/databases/$(database)/documents/chats/$(chatId)).data.get('ownerId', '') == request.auth.uid) || isAdmin();

      match /messages/{messageId} {
        allow get, list: if isParticipant(chatId) && isNotBanned();
        allow create: if isParticipant(chatId) && isNotBanned();
        allow update: if isParticipant(chatId) && isNotBanned(); 
        allow delete: if (isSignedIn() && resource.data.senderId == request.auth.uid) || isAdmin();

        match /reactions/{reactionId} {
          allow get, list: if isParticipant(chatId) && isNotBanned();
          allow create: if isParticipant(chatId) && isNotBanned();
          allow update: if false;
          allow delete: if (isSignedIn() && resource.data.reactorId == request.auth.uid) || isAdmin();
        }
      }
    }
  }
}
