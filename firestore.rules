
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NUXUSCHAT SECURITY MODEL - FINAL STABLE VERSION
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Проверка участия через данные запроса или данные документа
    function isParticipant(participantIds) {
      return isSignedIn() && (request.auth.uid in participantIds);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      // Все вошедшие могут искать чаты
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      // Обновление разрешено всем вошедшим для вступления и печатания
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || (request.auth.uid in resource.data.adminIds));
    }

    match /chats/{chatId}/messages/{messageId} {
      // Чтение и запись только для участников. Прямая проверка через родительский документ
      allow get, list: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow update: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds); 
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds);
    }

    match /chats/{chatId}/messages/{messageId}/reactions/{reactionId} {
      allow get, list: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.reactorId == request.auth.uid;
    }
  }
}
