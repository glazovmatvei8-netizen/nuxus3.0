
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка администратора по UID и Email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    // ГЛОБАЛЬНОЕ ПРАВИЛО ДЛЯ АДМИНИСТРАТОРА
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if true; 
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Чаты и сообщения
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      // Доступ ко всем подколлекциям (messages, reactions)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
