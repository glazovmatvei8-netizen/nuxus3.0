
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Главный доступ для Администратора Ядра и владельца
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nuxus\\.chat'))
      );
    }

    // Глобальное правило для всех коллекций (Admin bypass)
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin();
      }
    }

    // Чаты (Группы, Каналы, ЛС)
    match /chats/{chatId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isPrimeAdmin() || request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Звонки (Полный доступ для всех пользователей для стабильной работы)
    match /calls/{callId} {
      allow read, list, create, update, delete: if isSignedIn();
    }

    // Правило для Collection Group (поиск сообщений по всем чатам)
    match /{path=**}/messages/{messageId} {
      allow read, list: if isSignedIn();
    }
  }
}
