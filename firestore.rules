
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Твой аккаунт администратора (GCvLucN8CjNcdaxPO2vmpZ84hNl1)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    // Правило для админа: безусловный доступ ко всему, включая подколлекции
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Пользователи: чтение профилей всем (для поиска), запись только себе
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Чаты и сообщения: доступ всем авторизованным для глобального поиска и чтения
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
