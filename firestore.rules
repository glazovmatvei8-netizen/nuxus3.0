
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotBanned() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userData = get(userPath).data;
      // Доступ разрешен если: профиля нет ИЛИ (флаг бана ложный И срок заморозки прошел)
      return isSignedIn() && (!exists(userPath) || (userData.get('isBanned', false) == false && (!userData.keys().has('frozenUntil') || duration(request.time - timestamp(userData.frozenUntil)).seconds() > 0)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Админ определяется по номеру телефона в его профиле
      return isSignedIn() && exists(userPath) && get(userPath).data.get('phone', '') == '+79513332147';
    }

    function isParticipant(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return isSignedIn() && exists(chatPath) && (request.auth.uid in get(chatPath).data.get('participantIds', []));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn() && isNotBanned();
      allow create: if isSignedIn() && isNotBanned();
      allow update: if (isSignedIn() && isNotBanned() && (isParticipant(chatId) || isAdmin())); 
      allow delete: if (isSignedIn() && exists(/databases/$(database)/documents/chats/$(chatId)) && get(/databases/$(database)/documents/chats/$(chatId)).data.get('ownerId', '') == request.auth.uid) || isAdmin();

      match /messages/{messageId} {
        allow get, list: if (isParticipant(chatId) || isAdmin()) && isNotBanned();
        allow create: if isParticipant(chatId) && isNotBanned();
        allow update: if (isParticipant(chatId) || isAdmin()) && isNotBanned(); 
        allow delete: if (isSignedIn() && resource.data.senderId == request.auth.uid) || isAdmin();

        match /reactions/{reactionId} {
          allow get, list: if (isParticipant(chatId) || isAdmin()) && isNotBanned();
          allow create: if isParticipant(chatId) && isNotBanned();
          allow update: if false;
          allow delete: if (isSignedIn() && resource.data.reactorId == request.auth.uid) || isAdmin();
        }
      }
    }
  }
}
