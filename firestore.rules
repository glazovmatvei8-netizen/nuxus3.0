
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка администратора по UID и Email (Абузер)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    // ГЛОБАЛЬНОЕ ПРАВИЛО ДЛЯ АДМИНИСТРАТОРА
    // Разрешает абсолютно любые операции с любыми документами
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      // Читать профили могут все (для поиска и отображения имен)
      allow read: if true; 
      // Изменять - только владелец
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Чаты и их содержимое
    match /chats/{chatId} {
      // Разрешаем авторизованным пользователям доступ к чатам
      // В MVP фильтрация по participantIds идет на клиенте
      allow read, write: if isSignedIn();

      // Рекурсивный доступ ко всем подколлекциям чата (messages, reactions, и т.д.)
      // Это исправляет ошибку Missing or insufficient permissions при открытии сообщений
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
