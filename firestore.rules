
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ГЛАВНЫЙ КОРЕНЬ NUXUS PRIME (Админы системы)
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'vnctow46' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.token.email == '79997457325@nuxus.chat' ||
        request.auth.token.email == '79513332147@nuxus.chat' ||
        request.auth.token.email == '+79997457325@nuxus.chat' ||
        request.auth.token.email == '+79513332147@nuxus.chat'
      );
    }

    // ПРИОРИТЕТНЫЙ ДОСТУП: Если это админ, разрешаем всё без исключений
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    function isAdmin() {
      return isPrimeAdmin() || (isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      ));
    }

    function isChatMember(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
      );
    }

    match /users/{userId} {
      allow list: if isSignedIn(); 
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /receivedGifts/{giftId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin();
      }
      
      match /stories/{storyId} {
        allow read, list: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /calls/{callId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == resource.data.callerId || 
        request.auth.uid == resource.data.receiverId
      );
    }

    match /chats/{chatId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, list, create: if (isChatMember(chatId) || isAdmin());
        allow update, delete: if (isChatMember(chatId) || isAdmin());
      }
    }

    // Поддержка collectionGroup для глобальных счетчиков непрочитанных
    match /{path=**}/messages/{messageId} {
      allow read, list: if isSignedIn();
    }
    
    match /{path=**}/stories/{storyId} {
      allow read, list: if isSignedIn();
    }
  }
}
