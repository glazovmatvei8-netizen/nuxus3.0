
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotBanned() {
      return !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '+79513332147';
    }

    function isParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return isSignedIn() && (chat.participantIds.hasAny([request.auth.uid]));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      // Разрешаем обновление своего профиля ИЛИ если обновляет админ (для бана)
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn() && isNotBanned();
      allow create: if isSignedIn() && isNotBanned();
      allow update: if isSignedIn() && isNotBanned(); 
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isParticipant(chatId) && isNotBanned();
      allow create: if isParticipant(chatId) && isNotBanned();
      allow update: if isParticipant(chatId) && isNotBanned(); 
      allow delete: if (isSignedIn() && resource.data.senderId == request.auth.uid) || isAdmin();
    }

    match /chats/{chatId}/messages/{messageId}/reactions/{reactionId} {
      allow get, list: if isParticipant(chatId) && isNotBanned();
      allow create: if isParticipant(chatId) && isNotBanned();
      allow update: if false;
      allow delete: if (isSignedIn() && resource.data.reactorId == request.auth.uid) || isAdmin();
    }
  }
}
