
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return isSignedIn() && (chat.participantIds.hasAny([request.auth.uid]));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isParticipant(chatId);
      allow create: if isParticipant(chatId);
      allow update: if isParticipant(chatId); 
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    match /chats/{chatId}/messages/{messageId}/reactions/{reactionId} {
      allow get, list: if isParticipant(chatId);
      allow create: if isParticipant(chatId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.reactorId == request.auth.uid;
    }
  }
}
