
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- СИСТЕМНЫЕ ФУНКЦИИ ЗАЩИТЫ (SERVER-SIDE) ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка на Брутфорс (Cooldown 2 секунды)
    function isNotSpamming() {
      let lastAction = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastActionTime;
      return lastAction == null || request.time > (lastAction + duration.value(2, 's'));
    }

    // АВТОРИТЕТНАЯ ПРОВЕРКА ПРАВ (БЕЗ ХАРДКОДА ID)
    function isPrimeAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- ГЛОБАЛЬНЫЙ ДОСТУП ---
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    // --- ЗАЩИТА УЗЛОВ (USERS) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      allow update: if (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'balance', 'reputation', 'isBanned', 'premiumUntil', 'premiumTier', 'lastActionTime']))
        || isPrimeAdmin();
        
      allow delete: if isPrimeAdmin();

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isPrimeAdmin();
        allow write: if isPrimeAdmin();
      }

      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin();
      }
    }

    // --- ЗАЩИТА СООБЩЕНИЙ ---
    match /chats/{chatId}/messages/{messageId} {
      allow create: if isSignedIn() && 
                   request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
                   isNotSpamming();
      allow read: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow delete: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == resource.data.senderId);
      
      // РАЗРЕШЕНО: 1. Автор меняет текст. 2. Любой участник меняет ТОЛЬКО реакции.
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.senderId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'chatId', 'sentAt', 'contentType']))
        ||
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
      );
    }

    // --- ФИНАНСОВЫЙ ШЛЮЗ ---
    match /topUpRequests/{requestId} {
      allow create: if isSignedIn() && isNotSpamming(); 
      allow read: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if isPrimeAdmin();
    }
  }
}
