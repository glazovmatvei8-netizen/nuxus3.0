
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка админа по email в токене (самая быстрая)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == '79513332147@nuxus.chat';
    }

    function isNotBanned() {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;
      
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Если профиля еще нет, разрешаем доступ (для регистрации)
      // Если есть, проверяем флаг isBanned
      return !exists(userPath) || get(userPath).data.get('isBanned', false) == false;
    }

    function isParticipant(chatId) {
      if (!isSignedIn()) return false;
      if (isAdmin()) return true;
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return exists(chatPath) && (request.auth.uid in get(chatPath).data.get('participantIds', []));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      // Разрешаем листинг всем авторизованным и не забаненным
      // Фильтрация "своих" чатов происходит на уровне запроса в коде
      allow list: if isSignedIn() && isNotBanned();
      allow get: if isSignedIn() && (isParticipant(chatId) || isAdmin());
      allow create: if isSignedIn() && isNotBanned();
      allow update: if isSignedIn() && isNotBanned() && (isParticipant(chatId) || isAdmin()); 
      allow delete: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/chats/$(chatId)) && get(/databases/$(database)/documents/chats/$(chatId)).data.get('ownerId', '') == request.auth.uid);

      match /messages/{messageId} {
        allow get, list: if (isParticipant(chatId) || isAdmin()) && isNotBanned();
        allow create: if isParticipant(chatId) && isNotBanned();
        allow update: if (isParticipant(chatId) || isAdmin()) && isNotBanned(); 
        allow delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);

        match /reactions/{reactionId} {
          allow get, list: if (isParticipant(chatId) || isAdmin()) && isNotBanned();
          allow create: if isParticipant(chatId) && isNotBanned();
          allow delete: if isAdmin() || (isSignedIn() && resource.data.reactorId == request.auth.uid);
        }
      }
    }
  }
}
