
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Главный доступ для Администратора
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nuxus\\.chat'))
      );
    }

    // Правило для коллекций и подколлекций (Admin bypass)
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin();
      }
      
      match /stories/{storyId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Чаты и сообщения
    match /chats/{chatId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isPrimeAdmin() || request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Звонки
    match /calls/{callId} {
      allow read, write: if isSignedIn();
    }

    // Collection Group запросы (Важно для Историй и Глобального поиска)
    match /{path=**}/stories/{storyId} {
      allow read, list: if isSignedIn();
    }
    
    match /{path=**}/messages/{messageId} {
      allow read, list: if isSignedIn();
    }
  }
}
