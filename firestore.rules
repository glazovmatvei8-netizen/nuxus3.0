
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ГЛАВНЫЙ КОРЕНЬ NUXUS PRIME (vnctow46)
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'vnctow46' || 
        request.auth.token.email == '79997457325@nuxus.chat' ||
        request.auth.token.email == '+79997457325@nuxus.chat' ||
        request.auth.token.email == '79513332147@nuxus.chat'
      );
    }

    // МАКСИМАЛЬНЫЙ ОВЕРРАЙД ДЛЯ ВЛАДЕЛЬЦА
    function isMasterOverride() {
      return isSignedIn() && (
        request.auth.uid == 'vnctow46' || 
        request.auth.token.email.matches('.*79997457325.*') ||
        request.auth.token.email.matches('.*79513332147.*')
      );
    }

    function isAdmin() {
      return isPrimeAdmin() || isMasterOverride() || (isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '79997457325' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '79513332147'
        )
      ));
    }

    function isChatMember(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
      );
    }
    
    function isChatAdmin(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
         request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId ||
         isAdmin())
      );
    }

    match /users/{userId} {
      allow list: if true; // Разрешено для восстановления
      allow read: if isSignedIn() || isAdmin();
      allow write: if isPrimeAdmin() || isMasterOverride() || (isSignedIn() && request.auth.uid == userId);
      
      match /receivedGifts/{giftId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin();
      }
      
      match /stories/{storyId} {
        allow read, list: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /calls/{callId} {
      allow create, read, list, update, delete: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, list, create: if (isChatMember(chatId) || isAdmin());
        
        allow update: if isChatMember(chatId) && (
          request.auth.uid == resource.data.senderId || 
          isChatAdmin(chatId) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
        );
          
        allow delete: if isAdmin() || isChatAdmin(chatId) || (isSignedIn() && request.auth.uid == resource.data.senderId);
      }
    }

    // ПОЛНЫЙ ДОСТУП ДЛЯ ЯДРА
    match /{document=**} {
      allow read, write: if isPrimeAdmin() || isMasterOverride();
    }
  }
}
