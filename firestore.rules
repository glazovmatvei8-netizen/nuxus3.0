
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Главный доступ для Администратора Ядра и владельца
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nuxus\\.chat'))
      );
    }

    // Глобальное правило для всех коллекций (Admin bypass)
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount']))
      );
      // Разрешаем удалять свой собственный профиль
      allow delete: if isSignedIn() && (request.auth.uid == userId || isPrimeAdmin());
      
      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin();
      }

      match /transactions/{txId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Заявки на пополнение
    match /topUpRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isPrimeAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isPrimeAdmin();
    }

    // Чаты (Группы, Каналы, ЛС)
    match /chats/{chatId} {
      // Читать и обновлять чат могут только участники
      allow read, update: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();
      
      // УДАЛЕНИЕ: разрешено владельцу, любому админу или участнику личной переписки
      allow delete: if isSignedIn() && (
        isPrimeAdmin() || 
        request.auth.uid == resource.data.ownerId ||
        (resource.data.type == 'private' && request.auth.uid in resource.data.participantIds) ||
        (request.auth.uid in resource.data.adminIds)
      );

      // Сообщения внутри чата: ТОЛЬКО для участников этого конкретного чата
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          isPrimeAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
        );
      }
    }

    // Истории (Моменты)
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && (isPrimeAdmin() || resource.data.userId == request.auth.uid);
    }

    // Звонки (Приватные по participantIds)
    match /calls/{callId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (
        isPrimeAdmin() || 
        request.auth.uid in resource.data.participantIds
      );
    }

    // Правило для Collection Group (поиск сообщений)
    match /{path=**}/messages/{messageId} {
      // Доступ только если пользователь участник родительского чата
      allow read, list: if isSignedIn() && (
        isPrimeAdmin() || 
        request.auth.uid in get(path).data.participantIds
      );
    }
  }
}
