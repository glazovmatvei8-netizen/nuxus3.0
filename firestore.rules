
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ГЛОБАЛЬНЫЙ АДМИНИСТРАТОР (UID из запроса или токен)
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nuxus\\.chat')) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // ПРИОРИТЕТ АДМИНИСТРАТОРА (ДО ВСЕХ ПРАВИЛ)
    match /{document=**} {
      allow read, write, list: if isPrimeAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isPrimeAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount', 'lastSeen', 'lastIp', 'countryCode', 'balance', 'settings', 'statusEmoji', 'statusText', 'avatarUrl', 'name', 'username', 'bio']))
      );
      
      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == userId);
      }

      match /transactions/{txId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId;
      }

      match /sessions/{sessionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Заявки на пополнение
    match /topUpRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, list, write: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    // Чаты
    match /chats/{chatId} {
      allow read, update, list: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds || request.auth.uid == 'bot_nuxus_manager');
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (isPrimeAdmin() || request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, write, list: if isSignedIn() && (
          isPrimeAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds ||
          request.auth.uid == 'bot_nuxus_manager'
        );
      }
    }

    // Истории
    match /stories/{storyId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isPrimeAdmin() || resource.data.userId == request.auth.uid);
    }

    // Звонки
    match /calls/{callId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds);
    }
  }
}
