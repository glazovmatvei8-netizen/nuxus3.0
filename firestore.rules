
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Твой аккаунт администратора
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    // Правило для админа: полный доступ ко всему
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Пользователи: чтение всем, запись только себе
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Чаты и сообщения
    match /chats/{chatId} {
      // Публичные чаты (с username) можно искать всем
      allow read: if isSignedIn() || resource.data.username != null;
      allow write: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
        
        match /reactions/{reactionId} {
          allow read, write: if isSignedIn();
        }
      }
    }
  }
}
