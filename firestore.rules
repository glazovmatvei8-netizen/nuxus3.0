
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Простая и надежная проверка админа
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      // Базовые права на листинг и чтение для участников и админа
      allow list: if isSignedIn();
      allow get: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.participantIds));
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.participantIds)); 
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || (isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds));
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);

        match /reactions/{reactionId} {
          allow read: if isAdmin() || (isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds));
          allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
          allow delete: if isAdmin() || (isSignedIn() && resource.data.reactorId == request.auth.uid);
        }
      }
    }
  }
}
