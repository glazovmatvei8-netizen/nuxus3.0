
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Главный доступ для Администратора Ядра
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nuxus\\.chat'))
      );
    }

    // Проверка Premium статуса для защиты функций
    function isPremium() {
      return isPrimeAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true;
    }

    // Глобальное правило для всех коллекций (Admin bypass)
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    // Профили пользователей
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isPrimeAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount', 'lastSeen', 'lastIp', 'countryCode', 'balance', 'settings', 'statusEmoji', 'statusText', 'avatarUrl', 'name', 'username', 'bio']))
      );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isPrimeAdmin());
      
      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin();
      }

      match /transactions/{txId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isPrimeAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Заявки на пополнение
    match /topUpRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isPrimeAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isPrimeAdmin();
    }

    // Чаты (Группы, Каналы, ЛС)
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds || request.auth.uid == 'bot_nuxus_manager' || request.auth.uid == 'bot_stickers');
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (isPrimeAdmin() || request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          isPrimeAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds ||
          request.auth.uid == 'bot_nuxus_manager'
        );
      }
    }

    // Истории (Моменты) - ТОЛЬКО ДЛЯ PREMIUM
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isPremium();
      allow update: if isSignedIn() && (isPrimeAdmin() || resource.data.userId == request.auth.uid); 
      allow delete: if isSignedIn() && (isPrimeAdmin() || resource.data.userId == request.auth.uid);
    }

    // Звонки (История и активные)
    match /calls/{callId} {
      allow read: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isPrimeAdmin() || 
        request.auth.uid in resource.data.participantIds
      );
    }

    match /{path=**}/messages/{messageId} {
      allow read, list: if isSignedIn();
    }
  }
}
