
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NUXUSCHAT SECURITY MODEL - TELEGRAM STYLE
     * Публичные группы/каналы доступны для чтения всем.
     * Личные чаты и отправка сообщений - только участникам.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Проверка является ли чат публичным (группа или канал)
    function isPublicChat(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return chat.type == 'group' || chat.type == 'channel';
    }

    // Проверка участия в чате (используем hasAny для массивов)
    function isParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return isSignedIn() && (chat.participantIds.hasAny([request.auth.uid]));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      // Обновление (вступление, печатание) доступно всем вошедшим
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || (resource.data.adminIds.hasAny([request.auth.uid])));
    }

    match /chats/{chatId}/messages/{messageId} {
      // Чтение: участники ИЛИ если это публичный чат (группа/канал)
      allow get, list: if isSignedIn() && (isParticipant(chatId) || isPublicChat(chatId));
      
      // Создание: только участники
      allow create: if isSignedIn() && isParticipant(chatId);
      
      // Обновление: только участники
      allow update: if isSignedIn() && isParticipant(chatId); 
      
      // Удаление: автор или админ
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds.hasAny([request.auth.uid]));
    }

    match /chats/{chatId}/messages/{messageId}/reactions/{reactionId} {
      allow get, list: if isSignedIn() && (isParticipant(chatId) || isPublicChat(chatId));
      allow create: if isSignedIn() && isParticipant(chatId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.reactorId == request.auth.uid;
    }
  }
}
