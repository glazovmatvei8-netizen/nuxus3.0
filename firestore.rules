rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- СИСТЕМНЫЕ ФУНКЦИИ ЗАЩИТЫ ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка на Брутфорс (Cooldown 2 секунды между сигналами)
    function isNotSpamming() {
      return request.time > (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastActionTime + duration.value(2, 's'));
    }

    // Проверка прав Главного Архитектора (Admin)
    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- ГЛОБАЛЬНЫЙ ДОСТУП ---
    match /{document=**} {
      allow read, write: if isPrimeAdmin();
    }

    // --- ЗАЩИТА УЗЛОВ (USERS) ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // ПОЛНЫЙ ЗАПРЕТ на изменение критических полей со стороны клиента
      allow update: if (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'balance', 'reputation', 'isBanned', 'premiumUntil', 'premiumTier', 'lastActionTime']))
        || isPrimeAdmin();
        
      allow delete: if false; // Удаление базы пользователей ЗАПРЕЩЕНО всем, кроме консоли управления

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isPrimeAdmin();
        allow write: if false; // Только серверные функции могут писать транзакции
      }
    }

    // --- ЗАЩИТА СООБЩЕНИЙ (ANTI-BRUTEFORCE) ---
    match /chats/{chatId}/messages/{messageId} {
      allow create: if isSignedIn() && 
                   request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
                   isNotSpamming(); // Не дает спамить сообщениями
      allow read: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
      allow delete: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == resource.data.senderId);
    }

    // --- ФИНАНСОВЫЙ ШЛЮЗ ---
    match /topUpRequests/{requestId} {
      allow create: if isSignedIn() && isNotSpamming(); 
      allow read: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow write: if isPrimeAdmin();
    }
  }
}