
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка администратора по UID и Email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    match /users/{userId} {
      // Читать профили могут все, изменять - только владелец или админ
      allow read: if true; 
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /chats/{chatId} {
      // Упрощаем: если залогинен - можешь видеть чаты (фильтрация идет на клиенте по participantIds)
      // Админ видит всё.
      allow read, write: if isAdmin() || isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isAdmin() || isSignedIn();

        match /reactions/{reactionId} {
          allow read, write: if isAdmin() || isSignedIn();
        }
      }
    }
  }
}
