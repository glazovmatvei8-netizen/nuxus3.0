
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Твой аккаунт администратора (по Email или UID)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    // ПРАВИЛО ДЛЯ АДМИНИСТРАТОРА: Полный доступ ко всему
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Пользователи: чтение всем, запись только себе
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Чаты и сообщения: доступ всем авторизованным (для упрощения и скорости)
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
        
        match /reactions/{reactionId} {
          allow read, write: if isSignedIn();
        }
      }
    }
  }
}
