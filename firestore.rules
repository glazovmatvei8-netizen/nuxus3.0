
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Проверка администратора по UID и Email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '79513332147@nuxus.chat' || 
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1'
      );
    }

    // Проверка на отсутствие бана (Админы всегда проходят)
    function isNotBanned() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAdmin() || (isSignedIn() && (!exists(userPath) || get(userPath).data.isBanned != true));
    }

    match /users/{userId} {
      allow read: if true; 
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      // Админы могут читать любые чаты, пользователи - те, где они участвуют
      allow read, list: if isAdmin() || (isSignedIn() && isNotBanned() && (resource == null || resource.data.participantIds.hasAny([request.auth.uid])));
      allow create: if isSignedIn() && isNotBanned();
      allow update: if isAdmin() || (isSignedIn() && isNotBanned() && resource.data.participantIds.hasAny([request.auth.uid])); 
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      match /messages/{messageId} {
        // Упрощаем правила для сообщений: админ видит всё, участник чата видит сообщения чата
        allow read, list: if isAdmin() || (isSignedIn() && isNotBanned());
        allow create: if isAdmin() || (isSignedIn() && isNotBanned());
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);

        match /reactions/{reactionId} {
          allow read: if isAdmin() || (isSignedIn() && isNotBanned());
          allow create: if isSignedIn() && isNotBanned();
          allow delete: if isAdmin() || (isSignedIn() && resource.data.reactorId == request.auth.uid);
        }
      }
    }
  }
}
