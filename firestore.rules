rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NUXUSCHAT SECURITY MODEL
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Вспомогательная функция для проверки участия
    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      return isSignedIn() && (request.auth.uid in chat.data.participantIds);
    }

    function isChatAdmin(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      return isSignedIn() && (request.auth.uid in chat.data.adminIds || chat.data.ownerId == request.auth.uid);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      // Читать чат могут участники или любой авторизованный для поиска каналов
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Позволяем обновлять (вступление, реакции в метаданных)
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.adminIds);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isSignedIn(); // Упрощаем для отладки, но ограничиваем в UI
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.senderId == request.auth.uid || isChatAdmin(chatId));
      allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isChatAdmin(chatId));
    }

    match /chats/{chatId}/messages/{messageId}/reactions/{reactionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reactorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.reactorId == request.auth.uid;
    }
  }
}