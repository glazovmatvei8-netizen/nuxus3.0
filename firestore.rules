
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nuxus\\.chat')) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // AEGIS RATE LIMITING (Basic)
    // Предотвращает спам записями
    function isRateLimited() {
       return request.time < resource.data.updatedAt + duration.value(5, 's');
    }

    match /{document=**} {
      allow read, write, list: if isPrimeAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isPrimeAdmin());
      
      match /receivedGifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if isPrimeAdmin() || (isSignedIn() && request.auth.uid == userId);
      }

      match /transactions/{txId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /topUpRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, list, write: if isPrimeAdmin();
    }

    match /chats/{chatId} {
      allow read, update, list: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();

      match /messages/{messageId} {
        allow read, write, list: if isSignedIn() && (
          isPrimeAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
        );
      }
    }
  }
}
