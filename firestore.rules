
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'oAMiCwJacaZPx5w3jaJtDoLPgZN2' ||
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '+79513332147'
        ))
      );
    }

    function isChatMember(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
      );
    }
    
    function isChatAdmin(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds ||
         request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId ||
         isAdmin())
      );
    }

    match /users/{userId} {
      allow read: if true; 
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      
      match /receivedGifts/{giftId} {
        allow read, list: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /calls/{callId} {
      allow create, read, list, update, delete: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read, list, create, update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /messages/{messageId} {
        allow read, list, create: if isChatMember(chatId) || isAdmin();
        
        allow update: if isChatMember(chatId) && (
          request.auth.uid == resource.data.senderId || 
          isChatAdmin(chatId) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
        );
          
        allow delete: if isAdmin() || isChatAdmin(chatId) || (isSignedIn() && request.auth.uid == resource.data.senderId);
      }
    }

    // Глобальный доступ для админов
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
