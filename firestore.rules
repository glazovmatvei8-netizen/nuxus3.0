rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimeAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'GCvLucN8CjNcdaxPO2vmpZ84hNl1' ||
        request.auth.uid == 'vnctow46' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    match /{document=**} {
      allow read, write, list: if isPrimeAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isPrimeAdmin());
    }

    match /chats/{chatId} {
      allow read, update, list: if isSignedIn() && (isPrimeAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();

      match /messages/{messageId} {
        allow read, write, list: if isSignedIn();
      }
    }

    match /topUpRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, list, write: if isPrimeAdmin();
    }

    match /stories/{storyId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isPrimeAdmin() || request.auth.uid == resource.data.userId);
    }
    
    match /calls/{callId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}