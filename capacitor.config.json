
{
  "appId": "com.nuxus.fun",
  "appName": "Nuxus",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "nuxus.fun",
    "allowNavigation": [
      "nuxus.fun",
      "chat.nuxus.fun",
      "www.nuxus.fun",
      "*.firebaseapp.com",
      "*.web.app",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "buildOptions": {
      "releaseType": "APK"
    }
  }
}
